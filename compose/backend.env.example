DB_DRIVER=postgres
# DATABASE_DSN is provided by compose.yaml.
GIN_MODE=release
LOG_LEVEL=info
ACCESS_LOG_MODE=important
MIGRATE_ON_START=true
AUTH_COOKIE_NAME=kang_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CSRF_ENABLED=true
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_STORE=memory
# Optional external services:
# RATE_LIMIT_STORE=redis
# RATE_LIMIT_REDIS_URL=redis://redis:6379/0
# Prometheus-compatible metrics store queried by the dashboard when analytics is enabled.
# Point at your VictoriaMetrics / Prometheus service (a hostname reachable from this container):
# PROMETHEUS_URL=http://victoria-metrics:9090
# See the monitoring guide: https://zaidanm16.github.io/kang-deploy/guides/monitoring/
# Optional offline license verification keys and signed license:
# KANG_LICENSE_PUBLIC_KEYS={}
# KANG_LICENSE=

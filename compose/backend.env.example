DB_DRIVER=postgres
# DATABASE_DSN is provided by compose.yaml.
GIN_MODE=release
LOG_LEVEL=info
ACCESS_LOG_MODE=important
MIGRATE_ON_START=true
# Set a separate random secret before saving Kong credentials. Keep it stable.
# If omitted, JWT_SECRET is used as the key material. Changing either effective
# key requires re-encrypting existing credentials; see the operations guide.
# KONG_CREDENTIAL_ENCRYPTION_KEY=
AUTH_COOKIE_NAME=kang_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CSRF_ENABLED=true
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_STORE=memory
# Optional external services:
# RATE_LIMIT_STORE=redis
# RATE_LIMIT_REDIS_URL=redis://redis:6379/0
# Prometheus-compatible metrics store queried by the dashboard when analytics is enabled.
# Point at your VictoriaMetrics / Prometheus service (a hostname reachable from this container):
# PROMETHEUS_URL=http://victoria-metrics:9090
# See the monitoring guide: https://zaidanm16.github.io/kang/guides/monitoring/
# Public verification keys supplied by the license issuer (not a private key):
# KANG_LICENSE_PUBLIC_KEYS={}
# Leave KANG_LICENSE unset to install/replace the signed license through /license.
# Setting it makes the license environment-managed and disables UI replacement.
# KANG_LICENSE=
# Optional: all three are required for profile-photo and organization-logo uploads.
# Keep real Cloudinary credentials in the private backend.env file, never in Git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
